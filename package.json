{
  "name": "local-continue-assistant",
  "displayName": "续聊助手",
  "description": "Cursor 续聊助手：队列、握手、状态反馈、附件输入、图片粘贴和官方聊天框重试助手。",
  "version": "1.4.2",
  "publisher": "local-codex",
  "license": "MIT",
  "icon": "media/extension-icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "activationEvents": [
    "onView:localContinue.panel",
    "onCommand:localContinue.open"
  ],
  "main": "./extension.js",
  "extensionKind": [
    "workspace",
    "ui"
  ],
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "local-continue-bottom-panel",
          "title": "续聊助手",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "local-continue-bottom-panel": [
        {
          "type": "webview",
          "id": "localContinue.panel",
          "name": "续聊助手",
          "icon": "media/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "localContinue.open",
        "title": "续聊助手：打开面板"
      },
      {
        "command": "localContinue.openWindow",
        "title": "续聊助手：在独立窗口打开面板"
      },
      {
        "command": "localContinue.installRule",
        "title": "续聊助手：给当前项目安装规则"
      },
      {
        "command": "localContinue.copyAgentInstruction",
        "title": "续聊助手：复制规则指令"
      },
      {
        "command": "localContinue.startWait",
        "title": "续聊助手：启动等待终端"
      },
      {
        "command": "localContinue.runDoctor",
        "title": "续聊助手：运行 doctor 自检"
      },
      {
        "command": "localContinue.sendInstruction",
        "title": "续聊助手：发送指令"
      },
      {
        "command": "localContinue.stop",
        "title": "续聊助手：停止循环"
      },
      {
        "command": "localContinue.installRetryPatch",
        "title": "续聊助手：安装官方聊天框重试助手"
      },
      {
        "command": "localContinue.uninstallRetryPatch",
        "title": "续聊助手：卸载官方聊天框重试助手"
      }
    ]
  },
  "scripts": {
    "package": "vsce package --no-dependencies --allow-missing-repository --out dist/"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.2"
  },
  "files": [
    "extension.js",
    "package.json",
    "README.md",
    "LICENSE",
    "media/extension-icon.png",
    "media/icon.svg",
    "media/panel.css",
    "media/panel.js",
    "media/official-retry-helper.js",
    "src/fs-utils.js",
    "src/local-channel.js",
    "src/paths.js",
    "src/settings.js",
    "src/sessions.js",
    "src/queue.js",
    "src/session-status.js",
    "src/history.js",
    "src/image-utils.js",
    "src/instruction-builder.js",
    "src/pickers.js",
    "src/retry-patch.js",
    "src/panel-html.js",
    "src/panel-provider.js",
    "src/cursor-history.js",
    "runtime/shared.js",
    "runtime/instruction.js",
    "runtime/mcp-server.js",
    "runtime/cutc_rules_template.mdc"
  ]
}
